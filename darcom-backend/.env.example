# Copy to .env and fill in real values. Never commit .env.
# Generate a secret with: openssl rand -base64 48
DB_URL=jdbc:postgresql://localhost:5432/darcom-db
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-must-be-at-least-32-bytes-long-xxxxxx
JWT_ISSUER=darcom
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Gmail SMTP (app password from Google Account > Security > 2-Step Verification > App passwords).
# Paste the 16-character password exactly as shown (spaces are fine). Never commit .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=you@gmail.com
APP_PUBLIC_URL=http://localhost:3000
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
