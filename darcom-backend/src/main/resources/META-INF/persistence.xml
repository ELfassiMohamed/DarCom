<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="invest-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.backend.domain.User</class>
        <class>com.backend.domain.Listing</class>
        <class>com.backend.domain.Photo</class>
        <class>com.backend.domain.Booking</class>
        <class>com.backend.domain.Message</class>
        <class>com.backend.domain.Report</class>
        <class>com.backend.domain.RefreshToken</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
